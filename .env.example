# Devoille Essentials runtime
PORT=80
DEVOILE_DATA_DIR=/data
DEVOILE_PUBLIC_BASE_URL=https://devoille.example.com
DEVOILE_COOKIE_SECURE=1

# Admin login
DEVOILE_ADMIN_EMAIL=
DEVOILE_ADMIN_PASSWORD=

# Google login, optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://devoille.example.com/api/auth/google/callback

# PesaPal, optional fallback
PESAPAL_ENVIRONMENT=live
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Safaricom Daraja M-PESA STK Push
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_BUSINESS_SHORT_CODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://devoille.example.com/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=Devoille
MPESA_PARTY_B=
